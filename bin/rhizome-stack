#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rhizome-stack/stack.env"
if [[ -f "$CONFIG_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  set +a
fi

export RHIZOME_STACK_ROOT="${RHIZOME_STACK_ROOT:-$HOME/.local/share/rhizome-stack}"
if [[ -f "$RHIZOME_STACK_ROOT/manifests/versions.json" ]]; then
  node_version="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["node_runtime"])' "$RHIZOME_STACK_ROOT/manifests/versions.json")"
  export PATH="$RHIZOME_STACK_ROOT/runtime/node-v$node_version-linux-x64/bin:$HOME/.npm-global/bin:$PATH"
fi

action="${1:-doctor}"
units=(openclaw-gateway.service openclaw-openwebui-adapter.service open-webui.service)

case "$action" in
  help|--help|-h)
    printf 'Rhizome Stack\n\n'
    printf '  welcome      Configure a provider and optional components\n'
    printf '  skills       List/install bundled skills\n'
    printf '  workforce    Routing advice or a bounded local Ornith job (JSON stdin)\n'
    printf '  creative     Start Qwen Image Desk or MiniMax Music 3\n'
    printf '  import       Import private documents or chat exports (supports --dry-run)\n'
    printf '  configure    Edit local configuration\n'
    printf '  doctor       Check commands, runtime files and configuration\n'
    printf '  start|stop|status  Manage core user services\n'
    printf '  smoke        Check core HTTP endpoints (does not verify inference)\n'
    ;;
  workforce)
    exec python3 "$RHIZOME_STACK_ROOT/components/rhizome_workforce.py" "${@:2}"
    ;;
  creative)
    creative_action="${2:-status}"
    case "$creative_action" in
      qwen|image)
        systemctl --user start qwen-image-desk.service
        xdg-open "http://127.0.0.1:${QWEN_IMAGE_DESK_PORT:-8841}/image-studio/" >/dev/null 2>&1 &
        ;;
      minimax|music)
        systemctl --user start minimax-music-api.service
        xdg-open "http://127.0.0.1:${MINIMAX_MUSIC_PORT:-8830}/" >/dev/null 2>&1 &
        ;;
      status)
        systemctl --user --no-pager status qwen-image-desk.service minimax-music-api.service
        ;;
      stop)
        systemctl --user stop qwen-image-desk.service minimax-music-api.service
        ;;
      *)
        printf 'usage: rhizome-stack creative {qwen|minimax|status|stop}\n' >&2
        exit 64
        ;;
    esac
    ;;
  skills)
    exec python3 "$RHIZOME_STACK_ROOT/tools/skills.py" "${@:2}"
    ;;
  welcome)
    exec python3 "${RHIZOME_STACK_ROOT:-$HOME/.local/share/rhizome-stack}/tools/welcome.py" "${@:2}"
    ;;
  import)
    exec python3 "${RHIZOME_STACK_ROOT:-$HOME/.local/share/rhizome-stack}/tools/import_owner_data.py" "${@:2}"
    ;;
  configure)
    "${EDITOR:-vi}" "$CONFIG_FILE"
    printf 'Local environment saved. Run "openclaw configure" for provider or channel login flows.\n'
    ;;
  doctor)
    failures=0
    for command in node npm python3 systemctl curl openclaw; do
      if command -v "$command" >/dev/null; then
        printf 'PASS command %s\n' "$command"
      else
        printf 'FAIL command %s\n' "$command"
        failures=$((failures + 1))
      fi
    done
    [[ -f "$CONFIG_FILE" ]] || { printf 'FAIL missing %s\n' "$CONFIG_FILE"; failures=$((failures + 1)); }
    [[ -n "${OPENCLAW_GATEWAY_TOKEN:-}" ]] || { printf 'FAIL empty OPENCLAW_GATEWAY_TOKEN\n'; failures=$((failures + 1)); }
    for relative in venvs/open-webui/bin/open-webui venvs/components/bin/python tools/welcome.py manifests/versions.json; do
      [[ -f "$RHIZOME_STACK_ROOT/$relative" ]] || { printf 'FAIL missing runtime file %s\n' "$relative"; failures=$((failures + 1)); }
    done
    printf 'Use smoke for HTTP health, then send a real chat to verify inference.\n'
    exit "$failures"
    ;;
  start)
    systemctl --user start "${units[@]}"
    ;;
  stop)
    systemctl --user stop "${units[@]}"
    ;;
  status)
    systemctl --user --no-pager status "${units[@]}"
    ;;
  smoke)
    curl --fail --silent --show-error --connect-timeout 5 --max-time 20 "http://127.0.0.1:${OPENCLAW_PORT:-18789}/" >/dev/null
    curl --fail --silent --show-error --connect-timeout 5 --max-time 20 "http://127.0.0.1:${OPENWEBUI_PORT:-8080}/health" >/dev/null
    curl --fail --silent --show-error --connect-timeout 5 --max-time 20 "http://127.0.0.1:${ADAPTER_PORT:-18888}/v1/models" >/dev/null
    printf 'PASS core HTTP endpoints\n'
    ;;
  *)
    printf 'usage: rhizome-stack {welcome|skills|workforce|creative|import|configure|doctor|start|stop|status|smoke|help}\n' >&2
    exit 64
    ;;
esac
