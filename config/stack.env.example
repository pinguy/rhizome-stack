# Copy to ~/.config/rhizome-stack/stack.env and edit locally.
# Never commit the populated file.
RHIZOME_STACK_ROOT=%h/.local/share/rhizome-stack
RHIZOME_ARCHIVE_DIR=%h/.local/share/rhizome-stack/memory/archive
RHIZOME_PYTHON=%h/.local/share/rhizome-stack/venvs/memory/bin/python
RHIZOME_QUERY_SCRIPT=%h/.local/share/rhizome-stack/components/query_memory_archive.py
OPENCLAW_PORT=18789
OPENWEBUI_PORT=8080
ADAPTER_PORT=18888
OPENCLAW_WEBUI_ADAPTER_PORT=18888
AUDIO_BRIDGE_PORT=8010
CHATTERBOX_PORT=8020
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BASE_URLS=http://127.0.0.1:11434
OPENAI_API_BASE_URLS=http://127.0.0.1:18888/v1
OPENAI_API_KEYS=local-adapter
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://127.0.0.1:8010/v1
AUDIO_STT_OPENAI_API_KEY=local-dev-key
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://127.0.0.1:8010/v1
AUDIO_TTS_OPENAI_API_KEY=local-dev-key
DEFAULT_OLLAMA_MODEL=qwen3:8b

# Optional integrations. Keep empty until configured on the target machine.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
BRAVE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENWEBUI_USER_ID=

# Generated locally by the installer when empty.
OPENCLAW_GATEWAY_TOKEN=
WEBUI_SECRET_KEY=

# Optional local model paths. Model files are not included in releases.
WHISPER_MODEL=%h/.local/share/rhizome-stack/models/faster-whisper-large-v3-turbo
CHATTERBOX_MODEL_DIR=%h/.local/share/rhizome-stack/models/chatterbox-nano
CHATTERBOX_REFERENCE_WAV=
# Bound a failed/stalled local Whisper worker; no model downloads on requests.
WHISPER_STARTUP_TIMEOUT_SECONDS=120
WHISPER_DECODE_TIMEOUT_SECONDS=300

# Optional creative applications. ComfyUI and model weights are installed only
# when explicitly requested with --with-creative / --download-creative-models.
COMFY_DIR=%h/.local/share/rhizome-stack/creative/ComfyUI
COMFY_URL=http://127.0.0.1:8188
COMFY_PORT=8188
MINIMAX_MUSIC_PORT=8830
QWEN_IMAGE_DESK_PORT=8841

# Optional workforce. Copy config/workforce.example.json to this private path first.
# Existing installations can add this variable locally; reinstall preserves stack.env.
RHIZOME_WORKFORCE_CONFIG=%h/.config/rhizome-stack/workforce.json
