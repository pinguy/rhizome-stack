[Unit]
Description=CPU-only Chatterbox-Nano TTS
After=network.target

[Service]
Type=simple
EnvironmentFile=@@HOME@@/.config/rhizome-stack/stack.env
Environment=CHATTERBOX_DEVICE=cpu
Environment=OMP_NUM_THREADS=16
Environment=MKL_NUM_THREADS=16
WorkingDirectory=@@STACK_ROOT@@/components
ExecStart=@@STACK_ROOT@@/venvs/voice/bin/python @@STACK_ROOT@@/components/chatterbox_nano_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

