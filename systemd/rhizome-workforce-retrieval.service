[Unit]
Description=Optional CPU-only MiniLM workforce retrieval
After=default.target

[Service]
Type=simple
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_DATASETS_OFFLINE=1
Environment=CUDA_VISIBLE_DEVICES=
Environment=PYTHONNOUSERSITE=1
Environment=NO_PROXY=*
Environment=no_proxy=*
WorkingDirectory=/tmp
ExecStart=@@STACK_ROOT@@/venvs/retrieval/bin/python @@STACK_ROOT@@/components/workforce_retrieval_server.py --config %h/.config/rhizome-stack/workforce.json
Restart=no
TimeoutStopSec=15

[Install]
WantedBy=default.target
