+def _ollama_capabilities_to_model_meta(model: dict) -> dict:
+    capabilities = set(model.get('capabilities') or [])
+    if not capabilities:
+        return {}
+
+    meta_capabilities = {}
+    for capability in ('vision', 'tools', 'thinking', 'completion'):
+        if capability in capabilities:
+            meta_capabilities[capability] = True
+
+    return {'capabilities': meta_capabilities} if meta_capabilities else {}
+
