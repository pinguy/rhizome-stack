+def _rhizome_compose_system(*prompts):
+    """Join authoritative and model-specific prompts once, preserving order."""
+    blocks = []
+    seen = set()
+    for prompt in prompts:
+        if not isinstance(prompt, str):
+            continue
+        prompt = prompt.strip()
+        if not prompt or prompt in seen:
+            continue
+        seen.add(prompt)
+        blocks.append(prompt)
+    return '\n\n---\n\n'.join(blocks)
+
+
+def _rhizome_first_positive_int(value):
+    try:
+        value = int(value)
+    except (TypeError, ValueError):
+        return None
+    return value if value > 0 else None
+
+
+def _rhizome_find_numeric_key(value, key_names):
+    if isinstance(value, dict):
+        for key in key_names:
+            found = _rhizome_first_positive_int(value.get(key))
+            if found:
+                return found
+        for child in value.values():
+            found = _rhizome_find_numeric_key(child, key_names)
+            if found:
+                return found
+    elif isinstance(value, list):
+        for child in value:
+            found = _rhizome_find_numeric_key(child, key_names)
+            if found:
+                return found
+    return None
+
+
+def _rhizome_provider_capabilities(model):
+    if not isinstance(model, dict):
+        return {}
+
+    capabilities = set()
+    ollama_metadata = model.get('ollama') or {}
+    if isinstance(ollama_metadata, dict):
+        capabilities.update(ollama_metadata.get('capabilities') or [])
+
+    model_meta = model.get('info', {}).get('meta', {})
+    provider_capabilities = {
+        capability: True
+        for capability in ('vision', 'tools', 'thinking', 'completion')
+        if capability in capabilities
+    }
+    if isinstance(model_meta, dict):
+        existing = model_meta.get('capabilities') or {}
+        if isinstance(existing, dict):
+            return {
+                **provider_capabilities,
+                **existing,
+            }
+
+    return provider_capabilities
+
+
+def _rhizome_dynamic_model_params(model, current_params):
+    current_params = current_params or {}
+    model_id = str(model.get('id') or '').removesuffix(':latest')
+    model_context_limit = _rhizome_find_numeric_key(
+        model,
+        ('context_length', 'num_ctx', 'max_context_length', 'max_context'),
+    )
+    base_num_ctx = (
+        _rhizome_first_positive_int(current_params.get('num_ctx'))
+        or RHIZOME_MODEL_NUM_CTX.get(model_id)
+        or RHIZOME_BASE_NUM_CTX
+    )
+    base_num_predict = (
+        _rhizome_first_positive_int(current_params.get('num_predict'))
+        or _rhizome_first_positive_int(current_params.get('max_tokens'))
+        or RHIZOME_BASE_NUM_PREDICT
+    )
+
+    if model_context_limit:
+        # Provider metadata is the advertised maximum context, not a good
+        # default allocation. Starting large Ollama models at their full
+        # window can make cold loads painfully slow.
+        base_num_ctx = min(base_num_ctx, model_context_limit)
+
+    return {
+        'think': False,
+        'num_ctx': base_num_ctx,
+        'num_predict': base_num_predict,
+        # Enforce this at the backend boundary. Browser/model state can retain
+        # an older shorter value and otherwise override the persisted default.
+        'keep_alive': RHIZOME_KEEP_ALIVE,
+    }
