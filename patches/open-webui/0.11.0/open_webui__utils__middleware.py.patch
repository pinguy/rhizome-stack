+def _coerce_qwen_fable_xml_parameter(value: str, schema: dict):
+    """Strictly coerce one Qwen XML parameter according to its registered schema."""
+    value = value.strip()
+    value_type = schema.get('type', 'string')
+
+    if value_type == 'string':
+        return value
+    if value_type == 'integer':
+        if not re.fullmatch(r'-?(?:0|[1-9][0-9]*)', value):
+            raise ValueError('invalid integer')
+        return int(value)
+    if value_type == 'number':
+        if not re.fullmatch(r'-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?', value):
+            raise ValueError('invalid number')
+        return float(value)
+    if value_type == 'boolean':
+        if value not in ('true', 'false'):
+            raise ValueError('invalid boolean')
+        return value == 'true'
+    if value_type in ('array', 'object'):
+        parsed = json.loads(value)
+        expected = list if value_type == 'array' else dict
+        if not isinstance(parsed, expected):
+            raise ValueError(f'invalid {value_type}')
+        return parsed
+    raise ValueError(f'unsupported parameter type: {value_type}')
+
