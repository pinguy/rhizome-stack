+def _rhizome_prepare_image_data_url_for_vision(data_url: str, min_edge: int = 224) -> str:
+    if not isinstance(data_url, str) or not data_url.startswith('data:image/') or ',' not in data_url:
+        return data_url
+
+    try:
+        header, encoded = data_url.split(',', 1)
+        image_bytes = base64.b64decode(encoded)
+
+        from PIL import Image
+
+        with Image.open(io.BytesIO(image_bytes)) as image:
+            width, height = image.size
+            if min(width, height) >= min_edge:
+                return data_url
+
+            scale = min_edge / max(1, min(width, height))
+            new_size = (max(1, round(width * scale)), max(1, round(height * scale)))
+            resample = getattr(Image, 'Resampling', Image).LANCZOS
+            image = image.convert('RGBA' if image.mode in ('RGBA', 'LA', 'P') else 'RGB')
+            image = image.resize(new_size, resample)
+
+            output = io.BytesIO()
+            if image.mode == 'RGBA':
+                image.save(output, format='PNG')
+                content_type = 'image/png'
+            else:
+                image.save(output, format='JPEG', quality=95)
+                content_type = 'image/jpeg'
+
+        return f'data:{content_type};base64,{base64.b64encode(output.getvalue()).decode("utf-8")}'
+    except Exception as e:
+        log.debug(f'Error preparing image for vision input: {e}')
+        return data_url
+
