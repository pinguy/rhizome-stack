+QWEN_FABLE_XML_PARAMETER_RE = re.compile(
+    r'(?s)<parameter=(?P<name>[A-Za-z_][A-Za-z0-9_]*)>\s*\n'
+    r'(?P<value>.*?)\n</parameter>\s*'
+)
+QWEN_FABLE_XML_ORPHAN_CLOSING_SUFFIX_RE = re.compile(
+    r'(?s)</parameter>\s*\n</function>\s*\n</tool_call>\s*$'
+)
+
