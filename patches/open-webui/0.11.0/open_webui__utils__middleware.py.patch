+def parse_qwen_fable_reasoning_tool_call(model_id: str, output: list, tools: dict):
+    """Promote one terminal FableVibes XML block only when it names a registered tool.
+
+    This is deliberately not a general XML/regex tool executor.  It is scoped to
+    the exact model, the final reasoning item, a fully anchored block, and the
+    registered tool schema.  Unknown, duplicated, missing, extra, or mistyped
+    parameters make the candidate inert.
+    """
+    normalized_model_id = str(model_id or '').removesuffix(':latest')
+    if normalized_model_id != QWEN_FABLE_XML_TOOL_MODEL:
+        return None
+
+    marker = 'FABLE_XML_FALLBACK_LIVE_20260802_R2'
+    log.info(
+        f'{marker} entered model_id={model_id!r} normalized={normalized_model_id!r} '
+        f'output_items={len(output or [])} registered_tools={sorted((tools or {}).keys())}'
+    )
+    if not output or not tools:
+        log.warning(f'{marker} rejected: missing output or registered tools')
+        return None
+
+    reasoning_item = output[-1]
+    if reasoning_item.get('type') != 'reasoning':
+        log.warning(
+            f'{marker} rejected: final item type={reasoning_item.get("type")!r}; '
+            f'final_item={reasoning_item!r}'
+        )
+        return None
+
+    text = ''.join(
+        str(part.get('text', ''))
+        for part in (reasoning_item.get('content') or [])
+        if part.get('type') == 'output_text'
+    )
+    match = QWEN_FABLE_XML_TOOL_BLOCK_RE.fullmatch(text)
+    if not match:
+        log.warning(f'{marker} rejected: terminal XML block regex mismatch; raw_reasoning={text!r}')
+        return None
+
+    function_name = match.group('name')
+    tool = tools.get(function_name)
+    if not tool:
+        log.warning(
+            f'{marker} rejected: unregistered function={function_name!r}; '
+            f'registered_tools={sorted(tools.keys())}'
+        )
+        return None
+
+    spec = tool.get('spec', {}) or {}
+    parameter_schema = spec.get('parameters', {}) or {}
+    properties = parameter_schema.get('properties', {}) or {}
+    required = set(parameter_schema.get('required', []) or [])
+    body = match.group('body')
+    arguments = {}
+    cursor = 0
+
+    try:
+        for parameter_match in QWEN_FABLE_XML_PARAMETER_RE.finditer(body):
+            if body[cursor : parameter_match.start()].strip():
+                log.warning(
+                    f'{marker} rejected: unexpected parameter-body text before '
+                    f'{parameter_match.group("name")!r}; body={body!r}; schema={parameter_schema!r}'
+                )
+                return None
+            parameter_name = parameter_match.group('name')
+            if parameter_name not in properties or parameter_name in arguments:
+                log.warning(
+                    f'{marker} rejected: unknown or duplicate parameter={parameter_name!r}; '
+                    f'body={body!r}; schema={parameter_schema!r}'
+                )
+                return None
+            raw_value = parameter_match.group('value')
+            if any(tag in raw_value for tag in ('<tool_call>', '</tool_call>', '<function=', '<parameter=')):
+                log.warning(
+                    f'{marker} rejected: nested tool markup in parameter={parameter_name!r}; '
+                    f'raw_value={raw_value!r}; schema={parameter_schema!r}'
+                )
+                return None
+            arguments[parameter_name] = _coerce_qwen_fable_xml_parameter(
+                raw_value,
+                properties.get(parameter_name, {}),
+            )
+            cursor = parameter_match.end()
+    except (TypeError, ValueError, json.JSONDecodeError) as exc:
+        log.warning(
+            f'{marker} rejected: parameter coercion failed: {exc}; '
+            f'body={body!r}; schema={parameter_schema!r}'
+        )
+        return None
+
+    if body[cursor:].strip() or not required.issubset(arguments):
+        log.warning(
+            f'{marker} rejected: trailing body text or missing required parameters; '
+            f'trailing={body[cursor:]!r}; required={sorted(required)!r}; '
+            f'arguments={arguments!r}; schema={parameter_schema!r}'
+        )
+        return None
+
+    prefix = match.group('prefix')
+    reasoning_item['content'] = ([{'type': 'output_text', 'text': prefix}] if prefix else [])
+    call_id = output_id('fc')
+    function_call = {
+        'type': 'function_call',
+        'id': call_id,
+        'call_id': call_id,
+        'name': function_name,
+        'arguments': json.dumps(arguments),
+        'status': 'in_progress',
+    }
+    output.append(function_call)
+    log.info(
+        f'{marker} activated validated_function={function_name!r} '
+        f'arguments={arguments!r} call_id={call_id}'
+    )
+    return function_call
+
