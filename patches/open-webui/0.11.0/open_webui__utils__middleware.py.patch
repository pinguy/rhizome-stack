+def _rhizome_is_image_file_item(file_item: dict) -> bool:
+    if not isinstance(file_item, dict):
+        return False
+
+    content_type = (
+        file_item.get('content_type')
+        or file_item.get('mime_type')
+        or (file_item.get('meta') or {}).get('content_type')
+        or ((file_item.get('file') or {}).get('meta') or {}).get('content_type')
+        or ''
+    )
+    if str(content_type).startswith('image/'):
+        return True
+
+    name = (
+        file_item.get('name')
+        or file_item.get('filename')
+        or (file_item.get('file') or {}).get('filename')
+        or ''
+    )
+    return str(name).lower().endswith(('.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp', '.tif', '.tiff', '.avif'))
+
+
+def _rhizome_file_item_url_or_id(file_item: dict) -> str | None:
+    if not isinstance(file_item, dict):
+        return None
+
+    nested_file = file_item.get('file') or {}
+    return file_item.get('url') or file_item.get('id') or nested_file.get('id') or nested_file.get('url')
+
