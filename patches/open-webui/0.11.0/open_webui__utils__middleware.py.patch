+def get_assistant_text_from_output(output):
+    """Return only the final visible assistant message from structured output.
+
+    Open WebUI's voice autoplay still reads the legacy ``content`` field.
+    Responses-style providers store visible text in ``output`` instead, so
+    mirror the final answer into ``content`` without leaking reasoning, tool
+    output, or pre-tool prose that a model may repeat after its last tool call.
+    The complete structured receipt remains preserved in ``output``.
+    """
+    for item in reversed(output or []):
+        if item.get('type') != 'message' or item.get('role') != 'assistant':
+            continue
+        chunks = []
+        for part in item.get('content') or []:
+            if part.get('type') == 'output_text' and part.get('text'):
+                chunks.append(str(part['text']))
+        text = '\n'.join(chunks).strip()
+        if text:
+            return text
+    return ''
 
 
