+QWEN_FABLE_XML_TOOL_MODEL = 'qwen3-6-14b-a3b-fablevibes-mxfp4-moe'
+QWEN_FABLE_XML_TOOL_BLOCK_RE = re.compile(
+    r'(?s)^(?P<prefix>.*?)(?P<block><tool_call>\s*\n'
+    r'<function=(?P<name>[A-Za-z_][A-Za-z0-9_]*)>\s*\n'
+    r'(?P<body>.*?)\n</function>\s*\n</tool_call>\s*$'
+    r')'
