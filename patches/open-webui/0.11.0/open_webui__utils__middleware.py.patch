+def clean_qwen_fable_structured_tool_residue(model_id: str, output: list, response_tool_calls: list):
+    """Remove only terminal XML residue paired with a structured FableVibes call.
+
+    Ollama can successfully promote a native Qwen XML call to ``tool_calls`` while
+    leaving its terminal closing tags in reasoning_content.  Cleanup happens only
+    after the reasoning stream is fully assembled, only for this exact model, and
+    only when a structured call is actually about to be dispatched.  Non-terminal
+    and unpaired examples remain untouched.
+    """
+    normalized_model_id = str(model_id or '').removesuffix(':latest')
+    if normalized_model_id != QWEN_FABLE_XML_TOOL_MODEL or not output or not response_tool_calls:
+        return None
+
+    reasoning_item = output[-1]
+    if reasoning_item.get('type') != 'reasoning':
+        return None
+
+    parts = reasoning_item.get('content') or []
+    text_parts = [part for part in parts if part.get('type') == 'output_text']
+    if not text_parts:
+        return None
+    text = ''.join(str(part.get('text', '')) for part in text_parts)
+
+    # A complete native block may survive even though Ollama also emitted a
+    # structured call.  Remove it only when its function name equals a call that
+    # will actually be dispatched.  Argument/schema validation remains the
+    # responsibility of the normal structured-call path.
+    full_match = QWEN_FABLE_XML_TOOL_BLOCK_RE.fullmatch(text)
+    if full_match:
+        block = full_match.group('block')
+        if block.count('<tool_call>') != 1 or block.count('</tool_call>') != 1:
+            return None
+        structured_names = {
+            call.get('function', {}).get('name') for call in response_tool_calls
+        }
+        if full_match.group('name') not in structured_names:
+            return None
+        start, end = full_match.span('block')
+    else:
+        # Exact production failure: Ollama consumed the opening/function/value
+        # portion into tool_calls but leaked only the terminal closing tags.
+        residue_match = QWEN_FABLE_XML_ORPHAN_CLOSING_SUFFIX_RE.search(text)
+        if not residue_match:
+            return None
+        start, end = residue_match.span()
+
+    cleaned = text[:start] + text[end:]
+    reasoning_item['content'] = (
+        [{'type': 'output_text', 'text': cleaned}] if cleaned else []
+    )
+    log.info(
+        'FABLE_XML_STRUCTURED_RESIDUE_CLEANED '
+        f'model_id={model_id!r} removed_range=[{start},{end}) '
+        f'removed={text[start:end]!r} structured_functions='
+        f'{[call.get("function", {}).get("name") for call in response_tool_calls]!r}'
+    )
+    return {'start': start, 'end': end, 'removed': text[start:end], 'text': cleaned}
+
