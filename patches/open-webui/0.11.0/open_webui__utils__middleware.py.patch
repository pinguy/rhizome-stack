+async def rhizome_inject_image_files_into_messages(form_data: dict, metadata: dict, user=None) -> dict:
+    """Promote attached image files into provider vision content."""
+
+    messages = form_data.get('messages') or []
+    metadata_files = metadata.get('files') or []
+
+    if metadata_files:
+        for message in reversed(messages):
+            if message.get('role') == 'user':
+                existing = message.get('files') or []
+                message['files'] = [*existing, *metadata_files]
+                break
+
+    for message in messages:
+        if message.get('role') != 'user':
+            continue
+
+        image_files = [file_item for file_item in message.get('files', []) if _rhizome_is_image_file_item(file_item)]
+        if not image_files:
+            continue
+
+        content = message.get('content', '')
+        if isinstance(content, list):
+            content_parts = content
+        else:
+            content_parts = [{'type': 'text', 'text': content or 'Describe the attached image.'}]
+
+        seen_urls = {
+            item.get('image_url', {}).get('url')
+            for item in content_parts
+            if isinstance(item, dict) and item.get('type') == 'image_url'
+        }
+
+        for file_item in image_files:
+            image_ref = _rhizome_file_item_url_or_id(file_item)
+            if not image_ref or image_ref in seen_urls:
+                continue
+
+            try:
+                image_data_url = await get_image_base64_from_url(image_ref, user=user)
+            except Exception as e:
+                log.debug(f'Error loading image attachment for vision input: {e}')
+                image_data_url = None
+
+            if image_data_url:
+                image_data_url = _rhizome_prepare_image_data_url_for_vision(image_data_url)
+
+            content_parts.append({'type': 'image_url', 'image_url': {'url': image_data_url or image_ref}})
+            seen_urls.add(image_data_url or image_ref)
+
+        message['content'] = content_parts
+
+    last_user_idx = None
+    for idx in range(len(messages) - 1, -1, -1):
+        if messages[idx].get('role') == 'user':
+            last_user_idx = idx
+            break
+
+    if last_user_idx is not None:
+        last_user = messages[last_user_idx]
+        last_prompt = get_content_from_message(last_user)
+        if _rhizome_prompt_refers_to_image(last_prompt) and not _rhizome_image_parts(last_user):
+            prior_images = []
+            for prior in reversed(messages[:last_user_idx]):
+                if prior.get('role') != 'user':
+                    continue
+                prior_images = _rhizome_image_parts(prior)
+                if prior_images:
+                    break
+
+            if prior_images:
+                content = last_user.get('content', '')
+                if isinstance(content, list):
+                    content_parts = content
+                else:
+                    content_parts = [{'type': 'text', 'text': content or 'Describe the attached image.'}]
+                content_parts.extend(copy.deepcopy(prior_images))
+                last_user['content'] = content_parts
+
+    return form_data
+
