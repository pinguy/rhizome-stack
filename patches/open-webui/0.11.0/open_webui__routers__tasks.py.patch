 router = APIRouter()
 
+# Hidden metadata jobs must not inherit a chat model's full output allowance.
+# These limits apply only to the dedicated task endpoints below, never normal
+# chat, tools, RAG, context size, or visible model output.
+TASK_GENERATION_TIMEOUT_SECONDS = 180
+TASK_OUTPUT_TOKEN_LIMITS = {
+    TASKS.TITLE_GENERATION: 128,
+    TASKS.TAGS_GENERATION: 128,
+    TASKS.FOLLOW_UP_GENERATION: 384,
+    TASKS.EMOJI_GENERATION: 16,
+}
+
+
+def bounded_task_output_params(model: dict, task: TASKS) -> dict:
+    max_tokens = TASK_OUTPUT_TOKEN_LIMITS[task]
+    return (
+        {'max_tokens': max_tokens}
+        if model.get('owned_by') == 'ollama'
+        else {'max_completion_tokens': max_tokens}
+    )
+
+
+async def generate_bounded_task(request: Request, payload: dict, user, task: TASKS):
+    try:
+        async with asyncio.timeout(TASK_GENERATION_TIMEOUT_SECONDS):
+            return await generate_chat_completion(request, form_data=payload, user=user)
+    except TimeoutError:
+        log.error(
+            'Hidden %s task exceeded %ss and was cancelled',
+            task,
+            TASK_GENERATION_TIMEOUT_SECONDS,
+        )
+        return JSONResponse(
+            status_code=status.HTTP_504_GATEWAY_TIMEOUT,
+            content={'detail': f'Hidden {task} generation timed out.'},
+        )
+
