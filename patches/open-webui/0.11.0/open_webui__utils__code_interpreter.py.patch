+    async def _discard_kernel(self) -> None:
+        """Best-effort cleanup of a partially created kernel before a retry."""
+        if not self.kernel_id:
+            return
+        kernel_id, self.kernel_id = self.kernel_id, ''
+        try:
+            async with self.session.delete(
+                f'api/kernels/{kernel_id}', params=self.params
+            ) as response:
+                response.raise_for_status()
+        except Exception as err:
+            logger.warning('discard kernel failed: %s', err)
